# # Configuration
#
# - Overview https://ghostty.org/docs/config
#    - if `$XDG_CONFIG_HOME` is not defined, it defaults to `$HOME/.config/ghostty/config`
#    - macOS only: `$HOME/Library/Application\ Support/com.mitchellh.ghostty/config`
# - Option Reference https://ghostty.org/docs/config/#configuration-options
#
# Combine multiple configuration files by using the `config-file` option.
#
# ```
# config-file = some/relative/sub/config
# config-file = ?optional/config
# config-file = /absolute/path/config
# ```
#
# default config location in macOS changed:
# https://github.com/ghostty-org/ghostty/discussions/5687

font-size = 18

#
# Features
#

# Explicitly enable major features to ensure only the `path` feature is disabled
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# We've added `ssh-terminfo` to `shell-integration-features`,
# so Ghostty automatically converts `TERM` from `xterm-ghostty` to `xterm-256color`
# when connecting to remote hosts
#term = xterm-256color

clipboard-trim-trailing-spaces = true

#
# Apperance
#

# Check a list of available themes by `ghostty +list-themes`
theme = "iTerm2 Pastel Dark Background"
#theme = "Atom"
#theme = "GitHub Dark"

#cursor-style =
#cursor-style-blink =

window-padding-x = 20
window-padding-y = 12

#
# macOS only
#

window-vsync = true
window-colorspace = display-p3
#macos-titlebar-style = tabs # A little buggy on macOS 27 now. Wait to fix
macos-auto-secure-input = true
macos-secure-input-indication = true
